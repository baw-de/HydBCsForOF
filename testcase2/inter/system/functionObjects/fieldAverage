    writeControl    writeTime;                      // Choose: adjustableRunTime none outputTime runTime timeStep writeTime
    writeInterval   1;                              // How often to write according to writeControl            

    restartOnRestart false;                         // Restart the averaging on restart.
    restartOnOutput  false;                         // Restart the averaging on output.
    periodicRestart  false;                         // Periodically restart the averaging.
    restartPeriod    0.002;                         // Periodic restart period.

    fields
