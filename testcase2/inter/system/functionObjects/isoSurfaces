isoSurfaces01
{
    type            surfaces;
    libs            ("libsampling.so");

    writeControl    adjustableRunTime;         // Choose: adjustableRunTime none outputTime runTime timeStep writeTime
    writeInterval   1.0;                       // How often to write according to writeControl            

    // timeStart       100;                    // Activation time - defaults to -VGREAT
    // timeEnd         200;                    // De-activation time - defaults to VGREAT

    // sampleScheme  cellPoint;       // cell cellPatchConstrained cellPoint cellPointFace cellPointWallModified pointMVC
    // interpolationScheme cellPoint; // cell cellPatchConstrained cellPoint cellPointFace cellPointWallModified pointMVC

    surfaceFormat ensight;            // Data+mesh: abaqus boundaryData debug ensight foam nastran none raw starcd vtk vtp x3d                   
                                      // Mesh: abq tri nastran ac flma stlb smesh vtp x3d nas abaqus starcd stl flmaz obj vtk off
 
    formatOptions
    {
        ensight
        {
            collateTimes  true;    // True: Write mesh only once. Not for moving grids!
            format      binary;
        }
    }
    
    fields
    (
        U 
    );

    surfaces
    (
        alpha01
        {
            type            isoSurface;
            isoField        alpha.water;
            isoValue        0.1;
            interpolate     true;
        }
        alpha05
        {
            type            isoSurface;
            isoField        alpha.water;
            isoValue        0.5;
            interpolate     true;
        }
        alpha09
        {
            type            isoSurface;
            isoField        alpha.water;
            isoValue        0.9;
            interpolate     true;
        }
    );
}


