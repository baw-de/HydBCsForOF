defaultFieldValues
(
    // Global values (water and air)
    volScalarFieldValue alpha.water 0.
    volScalarFieldValue p_rgh 1.
    volVectorFieldValue U (0. 0. 0.) 
);


regions
(
    // Water upstream: Initilize U according to Q
    boxToCell
    {
        box (-9999. -9999.  -9999.) (5.0 9999. 0.5);

        fieldValues
        (
            volScalarFieldValue alpha.water 1.
            volVectorFieldValue U (0.2 0. 0.)
        );
    }

    
    // Water downstream: Initilize U according to Q
    boxToCell
    {
        box (5. -9999.  -9999.) (9999. 9999. 0.35);

        fieldValues
        (
            volScalarFieldValue alpha.water 1.
            volVectorFieldValue U (0.3 0. 0.)
        );
    }


