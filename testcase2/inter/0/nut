// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    xmin
    {
        type            calculated;
        value           uniform 0;
    }
    xmax
    {
        type            calculated;
        value           uniform 0;
    }
    
    zmax
    {
        type            calculated;
        value           uniform 0;
    }
    
    bottom
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.005;   // roughness height = sand-grain roughness (0 for smooth walls) [m]
        Cs              uniform 0.5;    // roughness constant, default 0.5
        value           uniform 0.0;
    }
    mywalls
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.005;   // roughness height = sand-grain roughness (0 for smooth walls) [m]
        Cs              uniform 0.5;    // roughness constant, default 0.5
        value           uniform 0.0;
    }
    frontplate
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.001;   // roughness height = sand-grain roughness (0 for smooth walls) [m]
        Cs              uniform 0.5;    // roughness constant, default 0.5
        value           uniform 0.0;
    }
    crown
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.001;   // roughness height = sand-grain roughness (0 for smooth walls) [m]
        Cs              uniform 0.5;    // roughness constant, default 0.5
        value           uniform 0.0;
    }
    backplate
    {
        type            nutkRoughWallFunction;
        Ks              uniform 0.001;   // roughness height = sand-grain roughness (0 for smooth walls) [m]
        Cs              uniform 0.5;    // roughness constant, default 0.5
        value           uniform 0.0;
    }
    ventilation
    {
        type            calculated;
        value           uniform 0;
    }
    
}
